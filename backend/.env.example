# Local dev defaults to SQLite (no setup needed). For production, set to the
# Render-managed Postgres connection string, e.g.:
# postgresql://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///./fpl.db

FPL_API_BASE=https://fantasy.premierleague.com/api

# Frontend origin allowed by CORS. localhost:3000 is always allowed in
# addition to this, so local dev works regardless of this setting.
FRONTEND_URL=http://localhost:3000
